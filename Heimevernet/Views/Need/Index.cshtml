@model IEnumerable<Heimevernet.Models.Need>
@{
    ViewData["Title"] = "Active Needs";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">

    <h1 class="h3 mb-0">Active Needs</h1>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Register Need
    </a>

</div>

@* row/col-* makes this stack to 1 column on mobile,
   2 on tablet, and 3 on desktop *@

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">

    @foreach (var need in Model)
    {
        var (badgeClass, badgeText) = need.Priority switch
        {
            Heimevernet.Models.NeedPriority.High =>
                ("bg-danger", "High Priority"),

            Heimevernet.Models.NeedPriority.Medium =>
                ("bg-warning text-dark", "Medium Priority"),

            _ =>
                ("bg-success", "Low Priority")
        };

        <div class="col">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start mb-2">

                        <span class="badge @badgeClass">
                            @badgeText
                        </span>

                        <span class="badge bg-secondary">
                            @need.Status
                        </span>

                    </div>

                    <h5 class="card-title mb-1">
                        @need.Title
                    </h5>

                    <p class="card-text text-muted small mb-1">
                        <i class="bi bi-geo-alt"></i>                         @need.FullAddress
                    </p>

                    <p class="card-text text-muted small mb-3">
                        <i class="bi bi-clock"></i>
                        @need.Deadline.ToString("dd.MM.yyyy HH:mm")
                    </p>

                    <a asp-action="Details"
                       asp-route-id="@need.Id"
                       class="btn btn-outline-primary btn-sm w-100">
                        View Details
                    </a>

                </div>

            </div>

        </div>
    }

</div>

@if (!Model.Any())
{
    <p class="text-muted mt-4">
        No active needs have been registered yet.
    </p>
}