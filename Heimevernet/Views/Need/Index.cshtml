@model IEnumerable<Heimevernet.ViewModels.Need.NeedViewModel>

@using Heimevernet.Models

@{
    ViewData["Title"] = "Registered Needs";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h1>Registered Needs</h1>
        <p class="text-muted mb-0">
            Overview of registered needs.
        </p>
    </div>

    <a asp-controller="Need" asp-action="Create" class="btn btn-primary">
        Register Need
    </a>
</div>

@if (Model.Any())
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">

        @foreach (var need in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-start mb-2">

                            @{
                                var badgeClass = need.Priority switch
                                {
                                    NeedPriority.Urgent => "bg-danger",
                                    NeedPriority.Planned => "bg-primary",
                                    _ => "bg-secondary"
                                };
                            }

                            <span class="badge @badgeClass">
                                @need.Priority
                            </span>

                            <span class="badge bg-secondary">
                                @need.Status
                            </span>

                        </div>

                        <h5 class="card-title">
                            @need.Title
                        </h5>

                        <p class="card-text text-muted small mb-1">
                            @need.CategoryName
                        </p>

                        <p class="card-text text-muted small mb-3">
                            <i class="bi bi-geo-alt"></i>
                            @need.FullAddress
                        </p>

                        @if (!string.IsNullOrWhiteSpace(need.Description))
                        {
                            <p class="card-text">
                                @need.Description
                            </p>
                        }

                        <a asp-controller="Need" asp-action="Details" asp-route-id="@need.Id"
                           class="btn btn-outline-primary btn-sm w-100">
                            View details
                        </a>

                    </div>

                </div>
            </div>
        }

    </div>
}
else
{
    <div class="alert alert-light border">
        No needs have been registered yet.
    </div>
}