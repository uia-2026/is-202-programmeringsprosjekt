@model Heimevernet.ViewModels.Need.NeedIndexViewModel

@using Heimevernet.Models
@using Heimevernet.DTOs.Needs

@{
    ViewData["Title"] = "Registered Needs";

    (string Css, string Label) PriorityChip(NeedPriority p) => p switch
    {
        NeedPriority.Low => ("chip-priority-low", "Low"),
        NeedPriority.Medium => ("chip-priority-medium", "Medium"),
        NeedPriority.Critical => ("chip-priority-critical", "Critical"),
        _ => ("chip-priority-medium", p.ToString())
    };

    (string Css, string Label) StatusChip(NeedStatus s) => s switch
    {
        NeedStatus.New => ("chip-status-new", "New"),
        NeedStatus.UnderReview => ("chip-status-underreview", "Under review"),
        NeedStatus.Assigned => ("chip-status-assigned", "Assigned"),
        NeedStatus.Resolved => ("chip-status-resolved", "Resolved"),
        _ => ("chip-status-new", s.ToString())
    };

    string AccentClassFor(NeedPriority p) => p switch
    {
        NeedPriority.Critical => "entity-card--critical",
        NeedPriority.Medium => "entity-card--medium",
        _ => "entity-card--low"
    };

    var isPublicActor = User.IsInRole("PublicActor");
    var showOnlyMine = isPublicActor && Model.Filter.ShowOnlyMine;

    var hasOtherFilters = Model.Filter.CategoryId.HasValue
        || Model.Filter.Priority.HasValue
        || Model.Filter.Status.HasValue
        || !string.IsNullOrWhiteSpace(Model.Filter.Region)
        || !string.IsNullOrWhiteSpace(Model.Filter.Search);

    var hasFilters = hasOtherFilters || showOnlyMine;

    var now = DateTime.Now;

    var loadError = ViewBag.LoadError as string;
}

<div id="needLoadingBar" class="list-loading-bar"></div>

<div class="page-header">
    <div>
        <h1>Registered Needs</h1>
        <p>Overview of registered needs. Filter, sort and search to find what matters right now.</p>
    </div>

    @if (isPublicActor)
    {
        <a asp-controller="Need" asp-action="Create" class="btn btn-brand">
            <i class="bi bi-plus-lg"></i> Register Need
        </a>
    }
</div>

<form method="get" asp-action="Index" class="filter-bar" id="needFilterForm">

    <select name="CategoryId" class="form-select" onchange="this.form.requestSubmit()" aria-label="Filter by type">
        <option value="">All types</option>
        @foreach (var category in Model.AvailableCategories)
        {
            <option value="@category.Id" selected="@(category.Id == Model.Filter.CategoryId)">@category.Name</option>
        }
    </select>

    <select name="Priority" class="form-select" onchange="this.form.requestSubmit()" aria-label="Filter by priority">
        <option value="">All priorities</option>
        @foreach (NeedPriority priority in Enum.GetValues(typeof(NeedPriority)))
        {
            <option value="@priority" selected="@(priority == Model.Filter.Priority)">@PriorityChip(priority).Label</option>
        }
    </select>

    <select name="Status" class="form-select" onchange="this.form.requestSubmit()" aria-label="Filter by status">
        <option value="">All status</option>
        @foreach (NeedStatus status in Enum.GetValues(typeof(NeedStatus)))
        {
            <option value="@status" selected="@(status == Model.Filter.Status)">@StatusChip(status).Label</option>
        }
    </select>

    <select name="Region" class="form-select" onchange="this.form.requestSubmit()" aria-label="Filter by region">
        <option value="">All regions</option>
        @foreach (var region in Model.AvailableRegions)
        {
            <option value="@region" selected="@(region == Model.Filter.Region)">@region</option>
        }
    </select>

    @if (isPublicActor)
    {
        <label class="filter-toggle form-switch" for="showOnlyMineNeeds">
            <input class="form-check-input"
                   type="checkbox"
                   role="switch"
                   id="showOnlyMineNeeds"
                   name="ShowOnlyMine"
                   value="true"
                   checked="@Model.Filter.ShowOnlyMine"
                   onchange="this.form.requestSubmit()" />
            <i class="bi bi-person"></i>
            <span>My needs only</span>
        </label>
    }

    <div class="input-group filter-bar-search">
        <input type="text" name="Search" value="@Model.Filter.Search" placeholder="Search needs..." class="form-control" aria-label="Search needs" />
        <button type="submit" class="btn filter-search-btn" aria-label="Search">
            <i class="bi bi-search"></i>
        </button>
    </div>

    <select name="Sort" class="form-select" onchange="this.form.requestSubmit()" aria-label="Sort">
        <option value="@NeedSortOption.CreatedAtDescending" selected="@(Model.Filter.Sort == NeedSortOption.CreatedAtDescending)">Newest first</option>
        <option value="@NeedSortOption.CreatedAtAscending" selected="@(Model.Filter.Sort == NeedSortOption.CreatedAtAscending)">Oldest first</option>
        <option value="@NeedSortOption.PriorityDescending" selected="@(Model.Filter.Sort == NeedSortOption.PriorityDescending)">Priority (high to low)</option>
        <option value="@NeedSortOption.DeadlineAscending" selected="@(Model.Filter.Sort == NeedSortOption.DeadlineAscending)">Deadline (soonest)</option>
    </select>

    @if (hasFilters)
    {
        <a asp-action="Index" class="filter-clear"><i class="bi bi-x-circle"></i> Clear filters</a>
    }

</form>

@if (loadError != null)
{
    <div class="state-panel state-error">
        <i class="bi bi-exclamation-triangle fs-3"></i>
        <strong>Couldn't load needs</strong>
        <span>@loadError</span>
        <a asp-action="Index" class="btn btn-brand btn-sm mt-2">Try again</a>
    </div>
}
else if (Model.Items.Any())
{
    <div class="entity-grid">
        @foreach (var need in Model.Items)
        {
            var (chipCss, chipLabel) = PriorityChip(need.Priority);
            var (statusCss, statusLabel) = StatusChip(need.Status);

            <div class="entity-card @AccentClassFor(need.Priority)">
                <div class="entity-card-head">
                    <h2 class="entity-card-title">@need.Title</h2>
                    <span class="chip @chipCss"><span class="chip-dot"></span>@chipLabel</span>
                </div>

                <span class="chip @statusCss">@statusLabel</span>

                <p class="entity-card-meta"><i class="bi bi-tag"></i> @need.CategoryName</p>
                <p class="entity-card-meta"><i class="bi bi-geo-alt"></i> @need.FullAddress</p>

                @if (need.Deadline is { } deadline)
                {
                    var isOpen = need.Status != NeedStatus.Resolved;
                    var isOverdue = isOpen && deadline < now;
                    var isDueSoon = isOpen && !isOverdue && deadline < now.AddHours(24);
                    var deadlineCss = isOverdue ? "is-overdue" : isDueSoon ? "is-due-soon" : null;

                    <p class="entity-card-meta @deadlineCss">
                        <i class="bi bi-clock"></i> Deadline: <strong>@deadline.ToString("dd.MM.yyyy HH:mm")</strong>
                        @if (isOverdue)
                        {
                            <span class="deadline-flag">Overdue</span>
                        }
                        else if (isDueSoon)
                        {
                            <span class="deadline-flag">Due soon</span>
                        }
                    </p>
                }

                <p class="entity-card-meta"><i class="bi bi-boxes"></i> Quantity needed: @need.QuantityNeeded</p>

                @if (!string.IsNullOrWhiteSpace(need.Description))
                {
                    <p class="entity-card-desc">@need.Description</p>
                }

                <div class="entity-card-footer">
                    <a asp-controller="Need" asp-action="Details" asp-route-id="@need.Id" class="btn btn-outline-brand btn-sm w-100">
                        View details
                    </a>
                </div>
            </div>
        }
    </div>
}
else if (showOnlyMine && !hasOtherFilters)
{
    <div class="state-panel">
        <i class="bi bi-inbox fs-3"></i>
        <strong>You haven't registered any needs yet</strong>
        <span>Needs you register will show up here.</span>
        <a asp-controller="Need" asp-action="Create" class="btn btn-brand btn-sm mt-2">
            <i class="bi bi-plus-lg"></i> Register Need
        </a>
    </div>
}
else
{
    <div class="state-panel">
        <i class="bi bi-inbox fs-3"></i>
        <strong>No needs match your filters</strong>
        <span>Try widening your search or clearing filters.</span>
        @if (hasFilters)
        {
            <a asp-action="Index" class="btn btn-outline-brand btn-sm mt-2">Clear filters</a>
        }
    </div>
}

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('needFilterForm');
            var bar = document.getElementById('needLoadingBar');
            if (!form || !bar) return;
            form.addEventListener('submit', function () {
                bar.classList.add('is-active');
            });
        })();
    </script>
}
