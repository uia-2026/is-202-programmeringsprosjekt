@model Heimevernet.ViewModels.Need.NeedViewModel

@{
	ViewData["Title"] = "Register Need";
}
<a asp-action="Index" class="btn-link ps-0 mb-3">Back to Overview</a>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-6">

        @* color-scheme: light forces native controls (the Priority <select>
           dropdown especially) to render with light-theme colors even if the
           browser/OS has forced dark mode on. Without this, some browsers draw
           the popup options using OS dark colors while the page itself stays
           light, which is what made the dropdown look "hidden" - it wasn't
           hidden, it was rendering white-on-white or similar. This is a
           browser/OS rendering quirk, not a bug in the HTML itself. *@

        <div class="card shadow-sm" style="color-scheme: light;">
            <div class="card-body">

                <h2 class="h4 mb-4">Register Need</h2>

                <form asp-action="Create" method="post" novalidate>

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger d-none">
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>

                        <input asp-for="Title"
                               class="form-control"
                               placeholder="E.g. Snow Removal – E39" />

                        <span asp-validation-for="Title"
                              class="text-danger small">
                        </span>
                    </div>

                    <div class="row">

                        <div class="col-12 col-sm-6 mb-3">
                            <label asp-for="Type" class="form-label"></label>

                            <select asp-for="Type"
                                    id="typeSelect"
                                    class="form-select">

                                <option value="">Select type...</option>

                                @foreach (var type in Heimevernet.Models.NeedTypes.All)
                                {
                                    <option value="@type">@type</option>
                                }

                            </select>

                            <span asp-validation-for="Type"
                                  class="text-danger small">
                            </span>

                            @* Hidden by default, revealed by JS only when
                               "Other" is selected *@

                            <div id="otherTypeWrapper" class="mt-2 d-none">
                                <input asp-for="OtherType"
                                       class="form-control"
                                       placeholder="Specify type" />
                            </div>
                        </div>

                    </div>

                    <h6 class="mb-3">Location</h6>

                    <div class="row">
                        <div class="col-12 col-md-8 mb-3">
                            <label asp-for="Street" class="form-label"></label>
                            <input asp-for="Street" class="form-control" placeholder="Street and house number" />
                            <span asp-validation-for="Street" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-4 mb-3">
                            <label asp-for="PostalCode" class="form-label"></label>
                            <input asp-for="PostalCode" class="form-control" placeholder="Postal code" />
                            <span asp-validation-for="PostalCode" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6 mb-3">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" placeholder="City" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6 mb-3">
                            <label asp-for="County" class="form-label"></label>
                            <input asp-for="County" class="form-control" placeholder="County" />
                            <span asp-validation-for="County" class="text-danger small"></span>
                        </div>

                        <div class="col-12 mb-3">
                            <label asp-for="Country" class="form-label"></label>
                            <input asp-for="Country" class="form-control" value="Norway" placeholder="Country" />
                            <span asp-validation-for="Country" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">

                        <div class="col-12 col-sm-6 mb-3">
                            <label asp-for="Deadline" class="form-label"></label>

                            <input asp-for="Deadline"
                                   class="form-control"
                                   type="datetime-local" />

                            <span asp-validation-for="Deadline"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="col-12 col-sm-6 mb-3">
                            <label asp-for="Priority" class="form-label"></label>

                            <select asp-for="Priority"
                                    class="form-select"
                                    asp-items="Html.GetEnumSelectList<Heimevernet.Models.NeedPriority>()">
                            </select>
                        </div>

                    </div>

                    <hr class="my-4" />

                    <h6 class="mb-3">Contact Person</h6>

                    @* Stacked vertically on purpose - a contact card reads
                       top to bottom (name, then how to reach them), not as a
                       row of unrelated fields side by side. *@

                    <div class="mb-3">
                        <label asp-for="ContactName" class="form-label"></label>

                        <input asp-for="ContactName"
                               class="form-control"
                               placeholder="Name" />

                        <span asp-validation-for="ContactName"
                              class="text-danger small">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ContactRole" class="form-label"></label>

                        <input asp-for="ContactRole"
                               class="form-control"
                               placeholder="E.g. Crisis Leader, Volunteer" />

                        <span asp-validation-for="ContactRole"
                              class="text-danger small">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ContactPhone" class="form-label"></label>

                        <input asp-for="ContactPhone"
                               class="form-control"
                               placeholder="Phone number" />

                        <span asp-validation-for="ContactPhone"
                              class="text-danger small">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ContactEmail" class="form-label"></label>

                        <input asp-for="ContactEmail"
                               class="form-control"
                               placeholder="Email address" />

                        <span asp-validation-for="ContactEmail"
                              class="text-danger small">
                        </span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label"></label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Short description of the need (optional)">
                        </textarea>

                        <span asp-validation-for="Description"
                              class="text-danger small">
                        </span>
                    </div>

                    <div class="d-flex flex-column flex-sm-row gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Register Need
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {

    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>

        // Toggles the "Other Type" text field on/off depending on whether
        // the user picked "Other" in the Type dropdown.
        // Plain vanilla JS, no framework needed for one toggle.

        const typeSelect = document.getElementById('typeSelect');
        const otherTypeWrapper =
            document.getElementById('otherTypeWrapper');

        function toggleOtherType() {

            if (typeSelect.value === 'Other') {
                otherTypeWrapper.classList.remove('d-none');
            } else {
                otherTypeWrapper.classList.add('d-none');
            }
        }

        typeSelect.addEventListener('change', toggleOtherType);

        // Run once on load in case of a validation re-render
        toggleOtherType();

    </script>
}