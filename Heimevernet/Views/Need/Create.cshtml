@model Heimevernet.ViewModels.Need.NeedCreateViewModel

@{
    var isEdit = (ViewData["IsEdit"] as bool?) == true;
    var editNeedId = ViewData["EditNeedId"] as int?;
    var pageTitle = isEdit ? "Edit Need" : "Register Need";
    ViewData["Title"] = pageTitle;
}

<a asp-action="@(isEdit ? "Details" : "Index")" asp-route-id="@(isEdit ? editNeedId : null)" class="back-link">
    <i class="bi bi-arrow-left"></i> Back to overview
</a>

<div class="form-card">

    <h1 class="form-card-title">@pageTitle</h1>
    <p class="form-card-subtitle">
        @(isEdit ? "Update the need's details." : "Describe what's needed so resource providers can respond.")
    </p>

    <form id="need-create-form" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? editNeedId : null)" method="post">

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="form-field-group">
            <label asp-for="Title"></label>
            <input asp-for="Title" class="form-control" placeholder="E.g. Snow removal" />
            <span asp-validation-for="Title" class="text-danger small"></span>
        </div>

        <div class="form-field-group">
            <label asp-for="CategoryId">Category</label>
            <select asp-for="CategoryId" class="form-select">
                <option value="">Select category...</option>
                @foreach (var category in Model.AvailableCategories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </select>
            <span asp-validation-for="CategoryId" class="text-danger small"></span>
        </div>

        <div class="form-field-group">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control" rows="4"
                      placeholder="Describe the need (optional)"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <h2 class="form-section-title">Location</h2>

        <!-- Hidden latitude/longitude fields; selection is done on the map below -->
        <input asp-for="Latitude" type="hidden" />
        <input asp-for="Longitude" type="hidden" />

        <div class="form-field-group">
            <label>Pick location on the map</label>

            <div id="map" class="form-map"></div>

            <div class="small mt-2">
                <span id="selected-coords">@(Model.Latitude != 0 || Model.Longitude != 0 ? Model.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture) + ", " + Model.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")</span>
            </div>

            <span asp-validation-for="Latitude" class="text-danger small d-block"></span>
            <span asp-validation-for="Longitude" class="text-danger small d-block"></span>
            <span asp-validation-for="Region" id="map-error" class="text-danger small mt-1 d-block"></span>
        </div>

        <h2 class="form-section-title">Details</h2>

        <div class="form-row-2">

            <div class="form-field-group">
                <label asp-for="Priority"></label>
                <select asp-for="Priority" class="form-select"
                        asp-items="Html.GetEnumSelectList<Heimevernet.Models.NeedPriority>()">
                </select>
                <span asp-validation-for="Priority" class="text-danger small"></span>
            </div>

            <div class="form-field-group">
                <label asp-for="Deadline"></label>
                <input asp-for="Deadline" class="form-control" type="datetime-local" />
                <span asp-validation-for="Deadline" class="text-danger small"></span>
            </div>

        </div>

        <div class="form-row-2">

            <div class="form-field-group">
                <label asp-for="QuantityNeeded"></label>
                <input asp-for="QuantityNeeded" class="form-control" type="number" min="1" max="10000" />
                <span asp-validation-for="QuantityNeeded" class="text-danger small"></span>
            </div>

            <div class="form-field-group">
                <label asp-for="ContactPoint"></label>
                <input asp-for="ContactPoint" class="form-control"
                       placeholder="Phone, email, or other contact information" />
                <span asp-validation-for="ContactPoint" class="text-danger small"></span>
            </div>

        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-brand">
                @(isEdit ? "Save changes" : "Register Need")
            </button>

            <a asp-action="@(isEdit ? "Details" : "Index")" asp-route-id="@(isEdit ? editNeedId : null)" class="btn btn-outline-brand">
                Cancel
            </a>
        </div>

    </form>

</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <!-- Leaflet CSS/JS for map selection -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        (function () {
            // Initialize map centered on Norway
            var map = L.map('map').setView([60.472, 8.4689], 5);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            var marker = null;

            // Place marker and update hidden inputs when user clicks the map.
            map.on('click', function (e) {
                var lat = e.latlng.lat;
                var lon = e.latlng.lng;

                if (marker) map.removeLayer(marker);
                marker = L.marker([lat, lon]).addTo(map);

                var latInput = document.querySelector('input[name="Latitude"]');
                var lonInput = document.querySelector('input[name="Longitude"]');
                if (latInput) latInput.value = lat;
                if (lonInput) lonInput.value = lon;

                var coordsEl = document.getElementById('selected-coords');
                if (coordsEl) coordsEl.textContent = lat.toFixed(6) + ', ' + lon.toFixed(6);

                // Clear any server-side validation message for Region when user picks a new point
                var errEl = document.getElementById('map-error');
                if (errEl) { errEl.textContent = ''; errEl.style.display = 'none'; }
            });

            function setMarker(lat, lng) {
                if (marker) {
                    marker.setLatLng([lat, lng]);
                } else {
                    marker = L.marker([lat, lng]).addTo(map);
                }
            }

            // Wire map click to set hidden latitude/longitude fields and marker.
            // Region will be resolved server-side when the form is submitted to avoid frequent external API calls.
            map.on('click', function (e) {
                var lat = e.latlng.lat;
                var lng = e.latlng.lng;

                var latEl = document.getElementById('Latitude');
                var lngEl = document.getElementById('Longitude');

                var latStr = lat.toFixed(6);
                var lngStr = lng.toFixed(6);

                if (latEl) latEl.value = latStr;
                if (lngEl) lngEl.value = lngStr;

                var selectedCoordsEl = document.getElementById('selected-coords');
                if (selectedCoordsEl) selectedCoordsEl.textContent = latStr + ', ' + lngStr;

                // hide any previous map error
                var mapErrorEl = document.getElementById('map-error');
                if (mapErrorEl) {
                    mapErrorEl.style.display = 'none';
                    mapErrorEl.textContent = '';
                }

                setMarker(lat, lng);
            });

            // If the user was redirected from the map with coordinates, use those first.
            var queryParams = new URLSearchParams(window.location.search);
            var queryLat = queryParams.get('lat');
            var queryLng = queryParams.get('lng');

            var initialLat = queryLat !== null && queryLat !== '' ? Number(queryLat) : @Model.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
            var initialLng = queryLng !== null && queryLng !== '' ? Number(queryLng) : @Model.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture);

            if (queryLat !== null && queryLat !== '' && queryLng !== null && queryLng !== '') {
                var latInput = document.querySelector('input[name="Latitude"]');
                var lonInput = document.querySelector('input[name="Longitude"]');
                if (latInput) latInput.value = Number(queryLat).toFixed(6);
                if (lonInput) lonInput.value = Number(queryLng).toFixed(6);

                var coordsEl = document.getElementById('selected-coords');
                if (coordsEl) coordsEl.textContent = Number(queryLat).toFixed(6) + ', ' + Number(queryLng).toFixed(6);
            }

            if (initialLat !== 0 || initialLng !== 0) {
                var latNum = Number(initialLat);
                var lngNum = Number(initialLng);
                setMarker(latNum, lngNum);
                map.setView([latNum, lngNum], 13);
            }
        })();
    </script>

    <script>
        (function () {
            var form = document.getElementById('need-create-form');
            if (!form) return;

            var deadlineEl = document.getElementById('Deadline');
            var deadlineError = document.querySelector('[data-valmsg-for="Deadline"]');
            var isEdit = @(isEdit ? "true" : "false");
            var originalDeadline = deadlineEl ? deadlineEl.value : '';

            function clearDeadlineError() {
                if (deadlineError) deadlineError.textContent = '';
                if (deadlineEl) deadlineEl.classList.remove('is-invalid');
            }

            function showDeadlineError(msg) {
                if (deadlineError) deadlineError.textContent = msg;
                if (deadlineEl) deadlineEl.classList.add('is-invalid');
            }

            form.addEventListener('submit', function (e) {
                if (!deadlineEl) return;

                var val = deadlineEl.value; // empty string when no value
                if (val) {
                    // Parse datetime-local as local time
                    var selected = new Date(val);
                    var now = new Date();

                    if (isNaN(selected.getTime())) {
                        // invalid input format — let server handle, but show generic message
                        e.preventDefault();
                        showDeadlineError('Invalid deadline format.');
                        deadlineEl.focus();
                        return;
                    }

                    if (selected <= now && (!isEdit || val !== originalDeadline)) {
                        e.preventDefault();
                        showDeadlineError('Deadline must be in the future.');
                        deadlineEl.focus();
                        return;
                    }
                }

                // valid or empty -> clear any client error and allow submit
                clearDeadlineError();
            });

            if (deadlineEl) {
                deadlineEl.addEventListener('input', function () {
                    // clear client-side message as user edits
                    clearDeadlineError();
                });
            }
        })();
    </script>
}