@model Heimevernet.ViewModels.Need.NeedViewModel

@{
    ViewData["Title"] = Model.Title;

    var (badgeClass, badgeText) = Model.Priority switch
    {
        Heimevernet.Models.NeedPriority.Urgent =>
            ("bg-danger", "Urgent"),

        Heimevernet.Models.NeedPriority.Planned =>
            ("bg-warning text-dark", "Planned"),

        _ =>
            ("bg-success", "Low Priority")
    };
}

<a asp-action="Index" class="btn btn-link ps-0 mb-3">
    <i class="bi bi-arrow-left"></i> Back to Overview
</a>

<div class="row">

    <div class="col-12 col-lg-8">

        <div class="card shadow-sm">

            <div class="card-body">

                <span class="badge @badgeClass mb-2">
                    @badgeText
                </span>

                <h2 class="h4">@Model.Title</h2>

                <dl class="row mt-4">

                    <dt class="col-sm-4">Category</dt>
                    <dd class="col-sm-8">
                        @Model.CategoryName
                    </dd>

                    <dt class="col-sm-4">Region</dt>
                    <dd class="col-sm-8">
                        @Model.Region
                    </dd>

                    <dt class="col-sm-4">Coordinates</dt>
                    <dd class="col-sm-8">
                        @Model.Latitude, @Model.Longitude
                    </dd>

                    <dt class="col-sm-4">Deadline</dt>
                    <dd class="col-sm-8">
                        @if (Model.Deadline.HasValue)
                        {
                            @Model.Deadline.Value.ToString(
                                "dddd dd.MM.yyyy, HH:mm")
                        }
                        else
                        {
                            <span class="text-muted">No deadline</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Contact</dt>
                    <dd class="col-sm-8">
                        @Model.ContactPoint
                    </dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-secondary">
                            @Model.Status
                        </span>
                    </dd>

                </dl>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <hr />

                    <h6>Description</h6>

                    <p class="mb-0">
                        @Model.Description
                    </p>
                }

            </div>
        </div>

    </div>

    <div class="col-12 col-lg-4 mt-3 mt-lg-0">

        <div class="card shadow-sm">

            <div class="card-body">

                <h6 class="card-title">Actions</h6>

                <button class="btn btn-success w-100 mb-2" type="button">
                    Find Resources
                </button>

                <button class="btn btn-outline-secondary w-100" type="button">
                    Mark as Resolved
                </button>

            </div>

        </div>

    </div>

</div>