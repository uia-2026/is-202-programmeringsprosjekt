@using System.Globalization
@model Heimevernet.ViewModels.Need.NeedDetailsViewModel

@{
    ViewData["Title"] = Model.Need.Title;

    var need = Model.Need;

    (string Css, string Label) PriorityChip(Heimevernet.Models.NeedPriority p) => p switch
    {
        Heimevernet.Models.NeedPriority.Low => ("chip-priority-low", "Low"),
        Heimevernet.Models.NeedPriority.Medium => ("chip-priority-medium", "Medium"),
        Heimevernet.Models.NeedPriority.Critical => ("chip-priority-critical", "Critical"),
        _ => ("chip-priority-medium", p.ToString())
    };

    (string Css, string Label) StatusChip(Heimevernet.Models.NeedStatus s) => s switch
    {
        Heimevernet.Models.NeedStatus.New => ("chip-status-new", "New"),
        Heimevernet.Models.NeedStatus.UnderReview => ("chip-status-underreview", "Under review"),
        Heimevernet.Models.NeedStatus.Assigned => ("chip-status-assigned", "Assigned"),
        Heimevernet.Models.NeedStatus.Resolved => ("chip-status-resolved", "Resolved"),
        _ => ("chip-status-new", s.ToString())
    };

        (string Css, string Label) ResourceChip(string s) => s switch
    {
        "Available" => ("chip-resource-available", "Available"),
        "Busy" => ("chip-resource-busy", "Busy"),
        _ => ("chip-resource-busy", s)
    };

   

    var (priorityCss, priorityLabel) = PriorityChip(need.Priority);
    var (statusCss, statusLabel) = StatusChip(need.Status);

    // Invariant culture ensures JavaScript receives "." as the decimal separator.
    var lat = need.Latitude.ToString(CultureInfo.InvariantCulture);
    var lng = need.Longitude.ToString(CultureInfo.InvariantCulture);
}

@section Styles {
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="" />

    <style>
        #needMap {
            height: 220px;
        }
    </style>
}

<a asp-action="Index" class="back-link">
    <i class="bi bi-arrow-left"></i> Back to overview
</a>

<div class="detail-layout">

    <div class="detail-card">

        <div class="detail-card-head">
            <div>
                <span class="chip @priorityCss"><span class="chip-dot"></span>@priorityLabel</span>
                <h1 class="detail-title">@need.Title</h1>
            </div>
            <span class="chip @statusCss">@statusLabel</span>
        </div>

        <div class="detail-grid">

            <div class="detail-field">
                <i class="bi bi-tag"></i>
                <div>
                    <div class="detail-field-label">Category</div>
                    <div class="detail-field-value">@need.CategoryName</div>
                </div>
            </div>

            <div class="detail-field">
                <i class="bi bi-geo-alt"></i>
                <div>
                    <div class="detail-field-label">Region</div>
                    <div class="detail-field-value">@need.Region</div>
                    <div class="detail-field-sub">@need.Latitude, @need.Longitude</div>
                </div>
            </div>

            <div class="detail-field">
                <i class="bi bi-clock"></i>
                <div>
                    <div class="detail-field-label">Deadline</div>
                    @if (need.Deadline.HasValue)
                    {
                        <div class="detail-field-value">@need.Deadline.Value.ToString("dddd dd.MM.yyyy, HH:mm")</div>
                    }
                    else
                    {
                        <div class="detail-field-value is-muted">No deadline</div>
                    }
                </div>
            </div>

            <div class="detail-field">
                <i class="bi bi-telephone"></i>
                <div>
                    <div class="detail-field-label">Contact</div>
                    <div class="detail-field-value">@need.ContactPoint</div>
                </div>
            </div>

            <div class="detail-field">
                <i class="bi bi-boxes"></i>
                <div>
                    <div class="detail-field-label">Quantity needed</div>
                    <div class="detail-field-value">@need.QuantityNeeded</div>
                </div>
            </div>

            <div class="detail-field">
                <i class="bi bi-calendar-plus"></i>
                <div>
                    <div class="detail-field-label">Created</div>
                    <div class="detail-field-value is-muted">@need.CreatedAt.ToString("dd.MM.yyyy, HH:mm") UTC</div>
                </div>
            </div>

        </div>

        @if (!string.IsNullOrWhiteSpace(need.Description))
        {
            <hr class="detail-divider" />

            <h2 class="detail-section-title">Description</h2>
            <p class="detail-desc">@need.Description</p>
        }

    </div>

    <div>
        <div class="side-card">
            <h2 class="side-card-title">Location</h2>
            <div id="needMap" class="map-panel" data-lat="@lat" data-lng="@lng"></div>
        </div>

        <div class="side-card">
            <h2 class="side-card-title">Actions</h2>

            @if (Model.CanProposeMatch)
            {
                <a asp-controller="Match"
                   asp-action="Propose"
                   asp-route-needId="@need.Id"
                   class="btn btn-brand w-100 mb-2">
                    Propose Match
                </a>
            }

            <a href="#nearby-resources"
               class="btn btn-brand w-100 mb-2">
                Find Resources
            </a>

            @if (need.IsOwner)
            {
                @if (need.Status != Heimevernet.Models.NeedStatus.Resolved)
                {
                    <a asp-action="Edit"
                       asp-route-id="@need.Id"
                       class="btn btn-outline-brand w-100 mb-2">
                        Edit Need
                    </a>
                }

                <form asp-action="Delete"
                      asp-route-id="@need.Id"
                      method="post"
                      class="mb-2"
                      onsubmit="return confirm('Delete this need? This cannot be undone.');">
                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-danger-soft w-100">
                        Delete Need
                    </button>
                </form>
            }

            <button class="btn btn-outline-brand w-100" type="button">
                Mark as Resolved
            </button>
        </div>
    </div>

</div>

<div class="detail-card mt-3" id="nearby-resources">
    <h2 class="side-card-title">
        Nearby Resources
        <span class="detail-field-sub">(within @Model.NearbyResourcesRadiusKm km)</span>
    </h2>

    @if (Model.NearbyResources.Count > 0)
    {
        <div class="nearby-list">
            @foreach (var resource in Model.NearbyResources)
            {
                var (resourceCss, resourceLabel) = ResourceChip(resource.Status);

                <div class="nearby-row">
                    <div>
                        <div class="nearby-row-title">@resource.Title</div>
                        <div class="nearby-row-meta">@resource.CategoryName &middot; @resource.Region</div>
                        <div class="nearby-row-meta">Contact: @resource.ContactPoint &middot; Quantity: @resource.QuantityOffered</div>
                    </div>

                    <div class="nearby-row-right">
                        <span class="chip @resourceCss">@resourceLabel</span>
                        <div class="nearby-row-distance">@resource.DistanceKm.ToString("0.0") km away</div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="detail-field-sub mb-0">
            No resources found within @Model.NearbyResourcesRadiusKm km of this need.
        </p>
    }
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>

    <script>
        (function () {
            const el = document.getElementById('needMap');
            const lat = parseFloat(el.dataset.lat);
            const lng = parseFloat(el.dataset.lng);

            const map = L.map(el, {
                scrollWheelZoom: false
            }).setView([lat, lng], 13);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            L.marker([lat, lng], {
                draggable: false
            }).addTo(map);
        })();
    </script>
}