@model Heimevernet.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Log In";
}

<div class="row justify-content-center my-5">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-dark border-dark rounded-0 alert-dismissible fade show mb-4 small" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card shadow-none border border-dark rounded-0 bg-white">
            <div class="card-body p-4 p-sm-5 text-dark">
                <h1 class="h3 card-title text-center mb-4 fw-bold text-uppercase text-dark tracking-wide">Log In</h1>

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold text-dark small text-uppercase"></label>
                        <input asp-for="Email" class="form-control rounded-0 border-dark bg-white text-dark shadow-none"
                               placeholder="name@example.com" autofocus />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold text-dark small text-uppercase"></label>
                        <input asp-for="Password"
                               class="form-control rounded-0 border-dark bg-white text-dark shadow-none"
                               placeholder="Enter password" type="password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-dark rounded-0 fw-bold py-2 text-uppercase">Log In</button>
                    </div>

                    <hr class="my-4 border-dark opacity-100">

                    <div class="text-center">
                        <span class="text-muted small">Don't have an account?</span><br />
                        <a asp-action="Register" class="text-dark fw-semibold text-decoration-underline small">Create
                            new account</a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }