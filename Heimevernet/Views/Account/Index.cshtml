@model Heimevernet.ViewModels.Account.AccountViewModel
@using Heimevernet.Models

@{
    ViewData["Title"] = "My Account";
    var roleLabel = Model.Role == UserRole.PublicActor ? "Public actor" : "Resource provider";
    var otherRoleLabel = Model.Role == UserRole.PublicActor ? "Resource provider" : "Public actor";
    var initial = Model.Username.Length > 0 ? Model.Username.Substring(0, 1).ToUpperInvariant() : "?";
}

@section Styles {
    <style>
        .app-main:has(.acct-page) {
            background: #eef3fa;
        }

        .acct-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1d385a;
            margin-bottom: 20px;
        }

        .acct-wrap {
            display: flex;
            gap: 24px;
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .acct-side {
            flex: 0 0 260px;
            background: #ffffff;
            border: 1px solid #e3e6ea;
            border-radius: 16px;
            box-shadow: 0 4px 16px rgba(29, 56, 90, 0.06);
            padding: 24px 20px;
        }

        .acct-main {
            flex: 1 1 420px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .acct-card {
            background: #ffffff;
            border: 1px solid #e3e6ea;
            border-radius: 16px;
            box-shadow: 0 4px 16px rgba(29, 56, 90, 0.06);
            padding: 24px;
        }

        .acct-avatar {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: #1d385a;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1.25rem;
            margin-bottom: 14px;
        }

        .acct-name {
            font-size: 1.1rem;
            font-weight: 700;
            color: #1d385a;
            margin-bottom: 8px;
        }

        .acct-role-badge {
            display: inline-block;
            background: #e9edf2;
            color: #1d385a;
            font-weight: 600;
            font-size: 0.82rem;
            padding: 5px 12px;
            border-radius: 999px;
        }

        .acct-side hr {
            border-color: #edf0f3;
            margin: 18px 0;
        }

        .acct-btn-outline {
            display: block;
            width: 100%;
            text-align: center;
            border: 1px solid #1d385a;
            color: #1d385a;
            background: #fff;
            border-radius: 10px;
            font-weight: 600;
            padding: 9px;
            margin-bottom: 10px;
            font-size: 0.9rem;
        }

        .acct-btn-outline:hover {
            background: #1d385a;
            color: #fff;
        }

        .acct-btn-switch {
            display: block;
            width: 100%;
            text-align: center;
            border: 1px solid #d7dde4;
            color: #9aa5b1;
            background: #f4f6f8;
            border-radius: 10px;
            font-weight: 600;
            padding: 9px;
            font-size: 0.9rem;
            cursor: not-allowed;
        }

        .acct-switch-note {
            font-size: 0.72rem;
            color: #9aa5b1;
            text-align: center;
            margin-top: 6px;
        }

        .acct-card h2 {
            font-size: 1.05rem;
            font-weight: 700;
            color: #1d385a;
            margin-bottom: 4px;
        }

        .acct-card-subtitle {
            color: #6b7a90;
            font-size: 0.85rem;
            margin-bottom: 18px;
        }

        .acct-fields-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px 20px;
            max-width: 640px;
        }

        .acct-field-label {
            display: block;
            font-size: 0.8rem;
            font-weight: 600;
            color: #4c5a6e;
            margin-bottom: 6px;
        }

        .acct-field-value {
            font-size: 0.92rem;
            color: #1a2430;
            background: #fff;
            border: 1px solid #d7e0ec;
            border-radius: 10px;
            padding: 9px 12px;
        }

        .acct-row-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            flex-wrap: wrap;
        }

        .acct-row-card .acct-row-text {
            flex: 1 1 260px;
        }

        .acct-row-card .acct-row-text .acct-card-subtitle {
            margin-bottom: 0;
        }
    </style>
}

<div class="acct-page">

    <h1 class="acct-title">Profile</h1>

    <div class="acct-wrap">

        <div class="acct-side">
            <div class="acct-avatar">@initial</div>
            <div class="acct-name">@Model.Username</div>
            <span class="acct-role-badge">@roleLabel</span>

            <hr />

            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="acct-btn-outline">Log out</button>
            </form>

            <button type="button" class="acct-btn-switch" disabled>
                Switch to @otherRoleLabel
            </button>
            <p class="acct-switch-note">Coming soon</p>
        </div>

        <div class="acct-main">

            <div class="acct-card">
                <h2>Account details</h2>
                <p class="acct-card-subtitle">Your registered account information.</p>

                <div class="acct-fields-grid">
                    <div>
                        <span class="acct-field-label">Username</span>
                        <div class="acct-field-value">@Model.Username</div>
                    </div>

                    <div>
                        <span class="acct-field-label">Role</span>
                        <div class="acct-field-value">@roleLabel</div>
                    </div>

                    <div style="grid-column: 1 / -1;">
                        <span class="acct-field-label">Email</span>
                        <div class="acct-field-value">@Model.Email</div>
                    </div>
                </div>
            </div>

            <div class="acct-card">
                <div class="acct-row-card">
                    <div class="acct-row-text">
                        <h2>Security</h2>
                        @if (Model.TwoFactorEnabled)
                        {
                            <p class="acct-card-subtitle">Two-factor authentication is enabled for your account.</p>
                        }
                        else
                        {
                            <p class="acct-card-subtitle">Add an extra layer of security by enabling two-factor authentication.</p>
                        }
                    </div>

                    @if (!Model.TwoFactorEnabled)
                    {
                        <a asp-controller="Account" asp-action="SetupTwoFactor" class="acct-btn-outline" style="width:auto; margin-bottom:0; padding:10px 20px; white-space:nowrap;">
                            Enable two-factor authentication
                        </a>
                    }
                </div>
            </div>

        </div>

    </div>

</div>