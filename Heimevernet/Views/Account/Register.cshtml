@model Heimevernet.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Register Account";
}

<div class="row justify-content-center my-5">
    <div class="col-12 col-sm-10 col-md-8 col-lg-6">

        <div class="card shadow-none border border-dark rounded-0 bg-white">
            <div class="card-body p-4 p-sm-5 text-dark">
                <h1 class="h3 card-title text-center mb-4 fw-bold text-uppercase text-dark tracking-wide">Register
                    Account</h1>

                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                        <div class="mb-3">
                            <label asp-for="Username" class="form-label fw-semibold text-dark small text-uppercase"></label>
                            <input asp-for="Username"
                                   class="form-control rounded-0 border-dark bg-white text-dark shadow-none"
                                   placeholder="Enter username" />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold text-dark small text-uppercase"></label>
                            <input asp-for="Email" class="form-control rounded-0 border-dark bg-white text-dark shadow-none"
                                   placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Password"
                                       class="form-label fw-semibold text-dark small text-uppercase"></label>
                                <input asp-for="Password"
                                       class="form-control rounded-0 border-dark bg-white text-dark shadow-none"
                                       placeholder="Enter password" type="password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword"
                                       class="form-label fw-semibold text-dark small text-uppercase"></label>
                                <input asp-for="ConfirmPassword"
                                       class="form-control rounded-0 border-dark bg-white text-dark shadow-none"
                                       placeholder="Confirm password" type="password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Role" class="form-label fw-semibold text-dark small text-uppercase"></label>
                            <select asp-for="Role" class="form-select rounded-0 border-dark bg-white text-dark shadow-none"
                                    asp-items="Html.GetEnumSelectList<Heimevernet.Models.UserRole>()">
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ActorType"
                                   class="form-label fw-semibold text-dark small text-uppercase"></label>
                            <input asp-for="ActorType"
                                   class="form-control rounded-0 border-dark bg-white text-dark shadow-none"
                                   placeholder="e.g. Municipality, Police, Private Person, Business" />
                            <span asp-validation-for="ActorType" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit"
                                    class="btn btn-dark rounded-0 fw-bold py-2 text-uppercase">Register</button>
                        </div>

                        <hr class="my-4 border-dark opacity-100">

                        <div class="text-center">
                            <a asp-action="Login" class="text-dark fw-semibold text-decoration-underline small">Already have
                                an account? Log in</a>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>

        @section Scripts {
            @{
                await Html.RenderPartialAsync("_ValidationScriptsPartial");
            }
        }