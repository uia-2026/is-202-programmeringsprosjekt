@model Heimevernet.ViewModels.Account.TwoFactorSetupViewModel
@{
    ViewData["Title"] = "Enable Two-Factor Authentication";
}

@section Styles {
    <style>
        .app-main:has(.tfa-page) {
            background: #eef3fa;
        }

        .tfa-page {
            max-width: 560px;
            margin: 0 auto;
        }

        .tfa-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #1d385a;
            font-size: 0.9rem;
            font-weight: 600;
            text-decoration: none;
            margin-bottom: 12px;
        }

        .tfa-back:hover {
            text-decoration: underline;
        }

        .tfa-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1d385a;
            margin-bottom: 20px;
        }

        .tfa-card {
            background: #ffffff;
            border: 1px solid #e3e6ea;
            border-radius: 16px;
            box-shadow: 0 4px 16px rgba(29, 56, 90, 0.06);
            padding: 24px;
        }

        .tfa-card h2 {
            font-size: 1.05rem;
            font-weight: 700;
            color: #1d385a;
            margin-bottom: 4px;
        }

        .tfa-subtitle {
            color: #6b7a90;
            font-size: 0.85rem;
            margin-bottom: 20px;
        }

        .tfa-qr {
            text-align: center;
            margin-bottom: 20px;
        }

        .tfa-qr img {
            width: 100%;
            max-width: 200px;
            height: auto;
            padding: 12px;
            background: #fff;
            border: 1px solid #d7e0ec;
            border-radius: 12px;
        }

        .tfa-key {
            background: #f4f7fb;
            border: 1px solid #d7e0ec;
            border-radius: 12px;
            padding: 14px 16px;
            margin-bottom: 20px;
        }

        .tfa-key-title {
            font-weight: 600;
            font-size: 0.8rem;
            color: #1d385a;
            margin-bottom: 4px;
        }

        .tfa-key-hint {
            color: #6b7a90;
            font-size: 0.82rem;
            margin-bottom: 10px;
        }

        .tfa-key-row {
            display: flex;
            gap: 8px;
        }

        .tfa-label {
            display: block;
            font-size: 0.8rem;
            font-weight: 600;
            color: #4c5a6e;
            margin-bottom: 6px;
        }

        .tfa-card .form-control {
            border: 1px solid #d7e0ec;
            border-radius: 10px;
            padding: 9px 12px;
        }

        .tfa-card .form-control:focus {
            border-color: #1d385a;
            box-shadow: 0 0 0 0.2rem rgba(29, 56, 90, .15);
        }

        .tfa-key-row .form-control {
            font-family: var(--bs-font-monospace);
            font-weight: 600;
            text-align: center;
            background: #fff;
            min-width: 0;
        }

        .tfa-card .tfa-code {
            text-align: center;
            font-family: var(--bs-font-monospace);
            font-size: 1.4rem;
            font-weight: 700;
            letter-spacing: 0.4em;
        }

        .tfa-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 20px;
        }

        .tfa-btn-primary,
        .tfa-btn-outline {
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.9rem;
            padding: 9px 20px;
            border: 1px solid #1d385a;
            text-align: center;
            text-decoration: none;
            white-space: nowrap;
        }

        .tfa-btn-primary {
            background: #1d385a;
            color: #fff;
        }

        .tfa-btn-primary:hover {
            background: #16293f;
            border-color: #16293f;
        }

        .tfa-btn-outline {
            background: #fff;
            color: #1d385a;
        }

        .tfa-btn-outline:hover,
        .tfa-btn-outline.is-done {
            background: #1d385a;
            color: #fff;
        }
    </style>
}

<div class="tfa-page">

    <a asp-controller="Account" asp-action="Index" class="tfa-back">
        <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to profile
    </a>

    <h1 class="tfa-title">Two-factor authentication</h1>

    <div class="tfa-card">
        <h2>Set up your authenticator app</h2>
        <p class="tfa-subtitle">
            Scan the QR code with an authenticator app such as
            Google Authenticator or Microsoft Authenticator, then enter the 6-digit code it shows.
        </p>

        <div class="tfa-qr">
            <img src="data:image/png;base64,@Model.QrCodeImageBase64"
                 alt="QR code for two-factor authentication setup" />
        </div>

        <div class="tfa-key">
            <div class="tfa-key-title">Can't scan the QR code?</div>
            <div class="tfa-key-hint">Enter this setup key manually in your authenticator app:</div>

            <div class="tfa-key-row">
                <input type="text" class="form-control" id="manualKey" value="@Model.ManualEntryKey"
                       aria-label="Setup key" readonly />
                <button class="tfa-btn-outline" type="button" onclick="copyKey()" id="copyBtn">
                    <i class="bi bi-clipboard me-1"></i>Copy
                </button>
            </div>
        </div>

        <form asp-action="SetupTwoFactor" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

            <label asp-for="Code" class="tfa-label">Verification code</label>
            <input asp-for="Code" class="form-control tfa-code" placeholder="000000"
                   autocomplete="one-time-code" inputmode="numeric" maxlength="6" autofocus />
            <span asp-validation-for="Code" class="text-danger small"></span>

            <div class="tfa-actions">
                <button type="submit" class="tfa-btn-primary">Enable 2FA</button>
                <a asp-controller="Account" asp-action="Index" class="tfa-btn-outline">Cancel</a>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function copyKey() {
            const copyText = document.getElementById("manualKey");

            navigator.clipboard.writeText(copyText.value);

            const btn = document.getElementById("copyBtn");

            btn.innerHTML = '<i class="bi bi-check2 me-1"></i>Copied!';
            btn.classList.add("is-done");

            setTimeout(function () {
                btn.innerHTML = '<i class="bi bi-clipboard me-1"></i>Copy';
                btn.classList.remove("is-done");
            }, 2000);
        }
    </script>
}
