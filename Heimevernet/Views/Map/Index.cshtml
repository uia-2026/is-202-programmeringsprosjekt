@{
    ViewData["Title"] = "Map";
    ViewData["MainClass"] = "app-main--full";
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <style>
        .map-page-full { flex: 1; position: relative; min-height: 0; }
        #leafletMap { position: absolute; inset: 0; }

        .map-legend-box {
            position: absolute; top: 70px; left: 16px; z-index: 500;
            background: #fcfcfe; border: 1px solid #e0eaf5; border-radius: 10px;
            padding: 10px 14px; font-size: 12px; color: #1d385a;
            box-shadow: 0 4px 14px rgba(10, 30, 60, .12); min-width: 160px;
        }
        .map-legend-box .legend-row { display: flex; align-items: center; gap: 8px; padding: 3px 0; }
        .map-legend-box .legend-dot { width: 11px; height: 11px; border-radius: 50%; flex: none; }

        .map-empty-note {
            position: absolute; bottom: 16px; left: 16px; z-index: 500;
            background: #fcfcfe; border: 1px solid #e0eaf5; border-radius: 8px;
            padding: 8px 12px; font-size: 11.5px; color: #6b7a90;
            box-shadow: 0 4px 14px rgba(10, 30, 60, .1); display: none;
        }

        .map-popup-kind {
            font-size: 10.5px; font-weight: 700; letter-spacing: .04em;
            color: #6b7a90; text-transform: uppercase; margin-bottom: 2px;
        }
        .map-popup-title { font-weight: 600; margin-bottom: 2px; }
        .map-popup-row { font-size: 12px; color: #44525f; margin: 1px 0; }
        .map-popup-badge {
            display: inline-block; color: #fff; font-size: 11px; font-weight: 600;
            padding: 2px 8px; border-radius: 999px; margin: 4px 0;
        }
        .map-popup-action {
            display: block; text-align: center; background: #1d385a; color: #fff;
            border-radius: 6px; padding: 6px 10px; font-size: 12px; font-weight: 600;
            text-decoration: none; margin-top: 8px;
        }
        .map-popup-toggle {
            display: block; width: 100%; text-align: center; background: none; border: none;
            color: #1d385a; font-size: 11.5px; padding: 6px 0 0; cursor: pointer;
        }
        .map-popup-extra {
            margin-top: 6px; padding-top: 6px; border-top: 1px solid #e0eaf5;
        }
    </style>
}

<div class="map-page-full">
    <div id="leafletMap"></div>

    <div class="map-legend-box">
        <div class="legend-row"><span class="legend-dot" style="background:#e4483c;"></span>Urgent need</div>
        <div class="legend-row"><span class="legend-dot" style="background:#f0a93b;"></span>Planned need</div>
        <div class="legend-row"><span class="legend-dot" style="background:#2e9e5b;"></span>Available resource</div>
        <div class="legend-row"><span class="legend-dot" style="background:#3b7dd8;"></span>Public actor</div>
    </div>

    <div class="map-empty-note" id="mapEmptyNote">
        No needs or resources have coordinates yet.
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="~/js/map.js" asp-append-version="true"></script>
}