@{
    ViewData["Title"] = "Map";
    ViewData["MainClass"] = "app-main--full";
}

@section Styles {
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="" />

    <link rel="stylesheet"
          href="~/css/map.css"
          asp-append-version="true" />
}

<div class="map-page-full">
    <div id="leafletMap"></div>

    <div class="map-legend-box" id="mapLegendBox" aria-label="Map legend">
        <button type="button"
                class="map-filter-toggle"
                id="mapLegendToggle"
                aria-expanded="true"
                aria-controls="mapLegendBody">
            <span>Legend</span>
            <span class="map-filter-toggle-icon" aria-hidden="true">▾</span>
        </button>

        <div class="map-filter-body" id="mapLegendBody">
            <div class="legend-row">
                <span class="legend-marker legend-need legend-need-low">
                    <span>L</span>
                </span>
                Low priority need
            </div>

            <div class="legend-row">
                <span class="legend-marker legend-need legend-need-medium">
                    <span>M</span>
                </span>
                Medium priority need
            </div>

            <div class="legend-row">
                <span class="legend-marker legend-need legend-need-critical">
                    <span>!</span>
                </span>
                Critical priority need
            </div>

            <div class="legend-row">
                <span class="legend-marker legend-resource">R</span>
                Available resource
            </div>

            <div class="legend-row">
                <span class="legend-marker legend-resource-busy">R</span>
                Busy resource
            </div>
        </div>
    </div>

    <div id="mapCapNote" class="map-cap-note" role="status">
        Too many results to show at once. Zoom in to see more.
    </div>

    <div class="map-filter-box" id="mapFilterBox">
        <button type="button"
                class="map-filter-toggle"
                id="mapFilterToggle"
                aria-expanded="true"
                aria-controls="mapFilterBody">
            <span>Filters</span>
            <span class="map-filter-toggle-icon" aria-hidden="true">▾</span>
        </button>

        <div class="map-filter-body" id="mapFilterBody">
            <div class="map-filter-group">
                <span class="map-filter-label">Type</span>

                <div class="map-filter-checks">
                    <label>
                        <input type="checkbox"
                               class="map-filter-kind"
                               value="Need"
                               checked />
                        Needs
                    </label>

                    <label>
                        <input type="checkbox"
                               class="map-filter-kind"
                               value="Resource"
                               checked />
                        Resources
                    </label>
                </div>
            </div>

            <div class="map-filter-group">
                <span class="map-filter-label">Need priority</span>

                <div class="map-filter-checks">
                    <label>
                        <input type="checkbox"
                               class="map-filter-priority"
                               value="Low"
                               checked />
                        Low
                    </label>

                    <label>
                        <input type="checkbox"
                               class="map-filter-priority"
                               value="Medium"
                               checked />
                        Medium
                    </label>

                    <label>
                        <input type="checkbox"
                               class="map-filter-priority"
                               value="Critical"
                               checked />
                        Critical
                    </label>
                </div>
            </div>

            <div class="map-filter-group">
                <label class="map-filter-label" for="mapFilterCategory">
                    Category
                </label>

                <select id="mapFilterCategory" class="map-filter-select">
                    <option value="">All categories</option>
                </select>
            </div>

            <div class="map-filter-group">
                <label class="map-filter-label" for="mapFilterRegion">
                    Region
                </label>

                <select id="mapFilterRegion" class="map-filter-select">
                    <option value="">All regions</option>
                </select>
            </div>

            <div class="map-filter-group">
                <label class="map-filter-label" for="mapFilterNeedStatus">
                    Need status
                </label>

                <select id="mapFilterNeedStatus" class="map-filter-select">
                    <option value="">All statuses</option>
                    <option value="New">New</option>
                    <option value="UnderReview">Under review</option>
                    <option value="Assigned">Assigned</option>
                    <option value="Resolved">Resolved</option>
                </select>
            </div>

            <div class="map-filter-group">
                <label class="map-filter-label" for="mapFilterResourceStatus">
                    Resource status
                </label>

                <select id="mapFilterResourceStatus" class="map-filter-select">
                    <option value="">All statuses</option>
                    <option value="Available">Available</option>
                    <option value="Busy">Busy</option>
                </select>
            </div>

            <div class="map-filter-group">
                <label class="map-filter-label" for="mapFilterRadius">
                    Distance from location
                </label>

                <div class="map-filter-distance-row">
                    <select id="mapFilterRadius"
                            class="map-filter-select"
                            disabled>
                        <option value="5">Within 5 km</option>
                        <option value="10" selected>Within 10 km</option>
                        <option value="25">Within 25 km</option>
                        <option value="50">Within 50 km</option>
                    </select>
                </div>

                <button type="button"
                        id="mapFilterLocationBtn"
                        class="map-filter-location-btn"
                        style="width: 100%; margin-top: 6px;">
                    Use my location
                </button>

                <div class="map-filter-distance-note"
                     id="mapFilterDistanceNote"
                     role="status">
                    Use your location to filter markers by distance.
                </div>
            </div>

            <button type="button"
                    id="mapFilterResetBtn"
                    class="map-filter-reset">
                Reset filters
            </button>
        </div>
    </div>

    <div class="map-empty-note" id="mapEmptyNote" role="status">
        No needs or resources in this area.
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>

    <script type="module"
            src="~/js/map/main.js"
            asp-append-version="true"></script>

    <script>
        (function () {
            var legendBox = document.getElementById('mapLegendBox');
            var legendToggle = document.getElementById('mapLegendToggle');
            if (!legendBox || !legendToggle) return;

            legendToggle.addEventListener('click', function () {
                var collapsed = legendBox.classList.toggle('collapsed');
                legendToggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
            });
        })();
    </script>
}