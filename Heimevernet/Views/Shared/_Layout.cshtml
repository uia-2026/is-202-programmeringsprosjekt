<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Heimevernet</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Heimevernet.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">
                    Heimevernet
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">

                        @{
                            var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                            var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                            var isAuthenticated = User.Identity?.IsAuthenticated == true;
                            var isPublicActor = User.IsInRole("PublicActor");
                            var isResourceProvider = User.IsInRole("ResourceProvider");

                            string ActiveClass(string controller, string? action = null)
                            {
                                if (currentController != controller)
                                    return string.Empty;

                                if (action != null && currentAction != action)
                                    return string.Empty;

                                return "active";
                            }
                        }

                        @if (isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("Home", "Index")" asp-controller="Home" asp-action="Index">
                                    Map
                                </a>
                            </li>
                        }

                        @if (isPublicActor || isResourceProvider)
                        {
                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("Need", "Index")" asp-controller="Need" asp-action="Index">
                                    Needs
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("Resource", "Index")" asp-controller="Resource"
                                   asp-action="Index">
                                    Resources
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("Match")" asp-controller="Match" asp-action="Index">
                                    My Matches
                                </a>
                            </li>
                        }

                        @if (isPublicActor)
                        {
                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("Need", "Create")" asp-controller="Need"
                                   asp-action="Create">
                                    Register Need
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("Resource", "PrintByRegion")" asp-controller="Resource"
                                   asp-action="PrintByRegion">
                                    Print Resource List
                                </a>
                            </li>
                        }

                        @if (isResourceProvider)
                        {
                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("Resource", "Create")" asp-controller="Resource"
                                   asp-action="Create">
                                    Register Resource
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("Resource", "MyResources")" asp-controller="Resource"
                                   asp-action="MyResources">
                                    My Resources
                                </a>
                            </li>
                        }

                    </ul>

                    <ul class="navbar-nav align-items-sm-center">

                        @if (isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("Account", "Index")" asp-controller="Account"
                                   asp-action="Index">
                                    My Account
                                </a>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link">
                                        Log out
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("Account", "Login")" asp-controller="Account"
                                   asp-action="Login">
                                    Log in
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("Account", "Register")" asp-controller="Account"
                                   asp-action="Register">
                                    Register
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Heimevernet -
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>