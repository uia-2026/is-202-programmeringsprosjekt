<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Heimevernet</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Heimevernet.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="app-shell">

        <header class="app-topbar">

            <a class="app-topbar-brand" asp-controller="Home" asp-action="Index">
                Heimevernet
            </a>

            <div class="app-topbar-search">
                <input type="search" id="globalSearchInput" placeholder= "Search for needs, resources, locations..." autocomplete="off" />
            </div>

            @{
                var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                var isAuthenticated = User.Identity?.IsAuthenticated == true;
                var isPublicActor = User.IsInRole("PublicActor");
                var isResourceProvider = User.IsInRole("ResourceProvider");
                var displayName = User.Identity?.Name ?? string.Empty;
                var initials = displayName.Length > 0 ? displayName.Substring(0, 1).ToUpper() : "?";
                var roleLabel = isPublicActor ? "Public Actor" : isResourceProvider ? "Resource Provider" : string.Empty;

                string ActiveClass(string controller, string? action = null)
                {
                    if (currentController != controller)
                        return string.Empty;

                    if (action != null && currentAction != action)
                        return string.Empty;

                    return "active";
                }
            }

            @if (isAuthenticated)
            {
                <div class ="app-user-card">
                   <a class ="app-user-identity @ActiveClass("Account", "Index")" asp-controller="Account" asp-action="Index">
                       <div class="app-user-avatar">@initials</div>
                       <div class="app-user-meta">
                           <div class="app-user-name">@displayName</div>
                           <div class="app-user-role">@roleLabel</div>
                        </div>
                    </a>
                </div>
                     
                        

            }
            else
            {
                <div class="app-user-card">
                    <a class="nav-link @ActiveClass("Account", "Login")" asp-controller="Account" asp-action="Login">
                        Log in
                    </a>
                    <a class="nav-link @ActiveClass("Account", "Register")" asp-controller="Account" asp-action="Register">
                        Register
                    </a>
                </div>
            }

        </header>

        <div class="app-body">

            <aside class="app-sidebar">
                <nav class="app-sidebar-nav">
                    <ul class="navbar-nav">

                        @if (isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("Map")" asp-controller="Map" asp-action="Index">
                                    Map
                                </a>
                            </li>
                        }

                        @if (isPublicActor || isResourceProvider)
                        {
                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("Need", "Index")" asp-controller="Need" asp-action="Index">
                                    Needs
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("Resource", "Index")" asp-controller="Resource" asp-action="Index">
                                    Resources
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("Match")" asp-controller="Match" asp-action="Index">
                                    My Matches
                                </a>
                            </li>
                        }

                        @if (isPublicActor)
                        {
                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("Need", "Create")" asp-controller="Need" asp-action="Create">
                                    Register Need
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("Resource", "PrintByRegion")" asp-controller="Resource" asp-action="PrintByRegion">
                                    Print List
                                </a>
                            </li>
                        }

                        @if (isResourceProvider)
                        {
                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("Resource", "Create")" asp-controller="Resource" asp-action="Create">
                                    Register Resource
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("Resource", "MyResources")" asp-controller="Resource" asp-action="MyResources">
                                    My Resources
                                </a>
                            </li>
                        }

                    </ul>
                </nav>
            </aside>

            <div class="app-content">

                <main class="app-main @ViewData["MainClass"]" role="main">

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @RenderBody()
                </main>

                <footer class="border-top footer text-muted">
                    <div class="container">
                        &copy; 2026 - Heimevernet -
                        <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </div>
                </footer>

            </div>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>