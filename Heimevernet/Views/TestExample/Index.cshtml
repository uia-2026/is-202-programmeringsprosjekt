@model Heimevernet.ViewModels.TestExample.TestExampleIndexViewModel
@{
    ViewData["Title"] = "TestExample";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="display-6">Resources</h1>
    <span class="badge bg-primary fs-6">@Model.Count total</span>
</div>

@if (Model.IsEmpty)
{
    <div class="alert alert-warning" role="alert">
        <h4 class="alert-heading">No resources found</h4>
        <p class="mb-0">Database is empty. Make sure the Aspire AppHost is running so the migrator can seed test data
            (Traktor / Drone).</p>
            <hr />
            <p class="mb-0"><small>Check: <code>dotnet run --project Heimevernet.AppHost</code> → should log "✅ Dev seed data
                inserted"</small></p>
            </div>
        }
else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Id</th>
                            <th>Type</th>
                            <th>Location</th>
                            <th>Available From</th>
                            <th>Contact</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Resources)
                        {
                            <tr>
                                <td>@r.Id</td>
                                <td>@r.Type</td>
                                <td><small>@r.Latitude.ToString("F4"), @r.Longitude.ToString("F4")</small></td>
                                <td>@r.AvailableFrom.ToString("g")</td>
                                <td>
                                    <div>@r.ContactName</div>
                                    <small class="text-muted">@r.ContactInfo</small>
                                </td>
                                <td>
                                    @{
                                        var badgeClass = r.Status switch
                                        {
                                            ResourceStatus.New => "bg-secondary",
                                            ResourceStatus.UnderReview => "bg-warning text-dark",
                                            ResourceStatus.Assigned => "bg-info text-dark",
                                            ResourceStatus.Resolved => "bg-success",
                                            _ => "bg-light text-dark"
                                        };
                                    }
                                    <span class="badge @badgeClass">@r.Status</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
