@model Heimevernet.ViewModels.TestExample.TestExampleIndexViewModel

@{
    ViewData["Title"] = "TestExample";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="display-6">Resources</h1>
    <span class="badge bg-primary fs-6">@Model.Count total</span>
</div>

@if (Model.IsEmpty)
{
    <div class="alert alert-warning" role="alert">
        <h4 class="alert-heading">No resources found</h4>

        <p class="mb-0">
            Database is empty. Make sure the Aspire AppHost is running
            so the migrator can seed test data (Traktor / Drone).
        </p>

        <hr />

        <p class="mb-0">
            <small>
                Check:
                <code>dotnet run --project Heimevernet.AppHost</code>
                → should log "Dev seed data inserted"
            </small>
        </p>
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-striped table-hover align-middle">

            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Location</th>
                    <th>Available From</th>
                    <th>Available To</th>
                    <th>Contact</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var resource in Model.Resources)
                {
                    <tr>
                        <td>@resource.Id</td>

                        <td>@resource.Title</td>

                        <td>@resource.CategoryName</td>

                        <td>
                            <div>@resource.Region</div>
                            <small class="text-muted">
                                @resource.Latitude.ToString("F4"),
                                @resource.Longitude.ToString("F4")
                            </small>
                        </td>

                        <td>
                            @resource.AvailableFrom.ToString("g")
                        </td>

                        <td>
                            @if (resource.AvailableTo.HasValue)
                            {
                                @resource.AvailableTo.Value.ToString("g")
                            }
                            else
                            {
                                <span class="text-muted">No end date</span>
                            }
                        </td>

                        <td>@resource.ContactPoint</td>

                        <td>
                            @{
                                var badgeClass = resource.Status switch
                                {
                                    ResourceStatus.Available =>
                                        "bg-success",

                                    ResourceStatus.Busy =>
                                        "bg-warning text-dark",

                                    _ =>
                                        "bg-secondary"
                                };
                            }

                            <span class="badge @badgeClass">
                                @resource.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>
}