@model Heimevernet.ViewModels.Resource.ResourceCreateViewModel

@{
    var isEdit = (ViewData["IsEdit"] as bool?) == true;
    var editResourceId = ViewData["EditResourceId"] as int?;
    var pageTitle = isEdit ? "Edit Resource" : "Register Resource";
    ViewData["Title"] = pageTitle;
}

<a asp-action="@(isEdit ? "Details" : "Index")" asp-route-id="@(isEdit ? editResourceId : null)" class="back-link">
    <i class="bi bi-arrow-left"></i> Back to overview
</a>

<div class="form-card">

    <h1 class="form-card-title">@pageTitle</h1>
    <p class="form-card-subtitle">
        @(isEdit ? "Update resource details." : "Provide the resource details and optionally upload a photo.")
    </p>

    <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? editResourceId : null)" method="post" enctype="multipart/form-data">

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="form-field-group">
            <label asp-for="Title"></label>
            <input asp-for="Title" class="form-control" placeholder="E.g. Snow plow" />
            <span asp-validation-for="Title" class="text-danger small"></span>
        </div>

        <div class="form-field-group">
            <label asp-for="CategoryId">Category</label>
            <select asp-for="CategoryId" class="form-select">
                <option value="">Select category...</option>
                @foreach (var category in Model.AvailableCategories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </select>
            <span asp-validation-for="CategoryId" class="text-danger small"></span>
        </div>

        <div class="form-field-group">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control" rows="4"
                      placeholder="Describe the resource (optional)"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <h2 class="form-section-title">Location</h2>

        <input asp-for="Latitude" type="hidden" />
        <input asp-for="Longitude" type="hidden" />

        <div class="form-field-group">
            <label>Pick location on the map</label>

            <div id="map" class="form-map"></div>

            <div class="small mt-2">
                <span id="selected-coords">@(Model.Latitude != 0 || Model.Longitude != 0 ? Model.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture) + ", " + Model.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")</span>
            </div>

            <span asp-validation-for="Latitude" class="text-danger small d-block"></span>
            <span asp-validation-for="Longitude" class="text-danger small d-block"></span>
            <span asp-validation-for="Region" id="map-error" class="text-danger small mt-1 d-block"></span>
        </div>

        <h2 class="form-section-title">Availability</h2>

        <div class="form-row-2">

            <div class="form-field-group">
                <label asp-for="AvailableFrom"></label>
                <input asp-for="AvailableFrom" class="form-control" type="datetime-local" />
                <span asp-validation-for="AvailableFrom" class="text-danger small"></span>
            </div>

            <div class="form-field-group">
                <label asp-for="AvailableTo"></label>
                <input asp-for="AvailableTo" class="form-control" type="datetime-local" />
                <span asp-validation-for="AvailableTo" class="text-danger small"></span>
            </div>

        </div>

        <div class="form-row-2">

            <div class="form-field-group">
                <label asp-for="QuantityOffered"></label>
                <input asp-for="QuantityOffered" class="form-control" type="number" min="1" max="10000" />
                <span asp-validation-for="QuantityOffered" class="text-danger small"></span>
            </div>

            <div class="form-field-group">
                <label asp-for="ContactPoint"></label>
                <input asp-for="ContactPoint" class="form-control"
                       placeholder="Phone, email, or other contact information" />
                <span asp-validation-for="ContactPoint" class="text-danger small"></span>
            </div>

        </div>

        @if (!isEdit)
        {
            <h2 class="form-section-title">Resource photo</h2>
            <p class="form-card-subtitle" style="margin-top:-8px;">
                Add a photo to help others identify the resource. This is optional.
            </p>

            <div class="form-field-group">
                <label for="Image" class="resource-upload-area w-100 rounded-3 p-4 text-center">
                    <div class="resource-upload-icon mb-2">
                        <i class="bi bi-cloud-arrow-up"></i>
                    </div>

                    <div class="fw-medium mb-1" id="upload-label">
                        Click to choose an image
                    </div>

                    <div class="text-secondary small">
                        JPG, PNG or WebP &middot; Maximum 5 MB
                    </div>

                    <input asp-for="Image" id="Image" type="file" class="visually-hidden"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                </label>

                <span asp-validation-for="Image" class="text-danger small"></span>

                <div id="image-preview-container" class="mt-3 d-none">
                    <div class="d-flex align-items-center gap-3 p-2 border rounded-3">
                        <img id="image-preview" src="" alt="Selected resource photo"
                             class="rounded object-fit-cover" style="width: 84px; height: 64px;" />

                        <div class="flex-grow-1 min-width-0">
                            <div id="image-name" class="small fw-medium text-break"></div>
                            <div id="image-size" class="small text-secondary"></div>
                        </div>

                        <button type="button" id="remove-image" class="btn btn-sm btn-outline-secondary">
                            Remove
                        </button>
                    </div>
                </div>
            </div>
        }

        <div class="form-actions">
            <button type="submit" class="btn btn-brand">
                <i class="bi @(isEdit ? "bi-check2" : "bi-plus-lg") me-1"></i>
                @(isEdit ? "Save changes" : "Register Resource")
            </button>

            <a asp-action="@(isEdit ? "Details" : "Index")" asp-route-id="@(isEdit ? editResourceId : null)" class="btn btn-outline-brand">
                Cancel
            </a>
        </div>

    </form>

</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        (function () {
            if (typeof L === 'undefined') {
                return;
            }

            var map = L.map('map').setView([60.472, 8.4689], 5);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            var marker = null;

            function setMarker(lat, lng) {
                if (marker) {
                    marker.setLatLng([lat, lng]);
                } else {
                    marker = L.marker([lat, lng]).addTo(map);
                }
            }

            function syncSelection(lat, lng) {
                var latInput = document.querySelector('input[name="Latitude"]');
                var lonInput = document.querySelector('input[name="Longitude"]');
                if (latInput) latInput.value = lat.toFixed(6);
                if (lonInput) lonInput.value = lng.toFixed(6);

                var coordsEl = document.getElementById('selected-coords');
                if (coordsEl) coordsEl.textContent = lat.toFixed(6) + ', ' + lng.toFixed(6);

                var errEl = document.getElementById('map-error');
                if (errEl) {
                    errEl.textContent = '';
                    errEl.style.display = 'none';
                }

                setMarker(lat, lng);
            }

            map.on('click', function (e) {
                syncSelection(e.latlng.lat, e.latlng.lng);
            });

            var queryParams = new URLSearchParams(window.location.search);
            var queryLat = queryParams.get('lat');
            var queryLng = queryParams.get('lng');

            var initialLat = queryLat !== null && queryLat !== '' ? Number(queryLat) : @Model.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
            var initialLng = queryLng !== null && queryLng !== '' ? Number(queryLng) : @Model.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture);

            if (queryLat !== null && queryLat !== '' && queryLng !== null && queryLng !== '') {
                var latInput = document.querySelector('input[name="Latitude"]');
                var lonInput = document.querySelector('input[name="Longitude"]');
                if (latInput) latInput.value = Number(queryLat).toFixed(6);
                if (lonInput) lonInput.value = Number(queryLng).toFixed(6);

                var coordsEl = document.getElementById('selected-coords');
                if (coordsEl) coordsEl.textContent = Number(queryLat).toFixed(6) + ', ' + Number(queryLng).toFixed(6);
            }

            if (initialLat !== 0 || initialLng !== 0) {
                var latNum = Number(initialLat);
                var lngNum = Number(initialLng);
                setMarker(latNum, lngNum);
                map.setView([latNum, lngNum], 13);
            }
        })();
    </script>

    <script>
        (() => {
            const input = document.getElementById('Image');
            const label = document.getElementById('upload-label');
            const container = document.getElementById('image-preview-container');
            const preview = document.getElementById('image-preview');
            const name = document.getElementById('image-name');
            const size = document.getElementById('image-size');
            const remove = document.getElementById('remove-image');

            if (!input || !label || !container || !preview || !name || !size || !remove) {
                return;
            }

            let previewUrl = null;

            input.addEventListener('change', () => {
                const file = input.files[0];

                if (previewUrl) {
                    URL.revokeObjectURL(previewUrl);
                    previewUrl = null;
                }

                if (!file) {
                    container.classList.add('d-none');
                    label.textContent = 'Click to choose an image';
                    return;
                }

                if (file.size > 5 * 1024 * 1024) {
                    alert('The image must not exceed 5 MB.');
                    input.value = '';
                    container.classList.add('d-none');
                    label.textContent = 'Click to choose an image';
                    return;
                }

                if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type)) {
                    alert('Choose a JPG, PNG or WebP image.');
                    input.value = '';
                    container.classList.add('d-none');
                    label.textContent = 'Click to choose an image';
                    return;
                }

                previewUrl = URL.createObjectURL(file);
                preview.src = previewUrl;
                name.textContent = file.name;
                size.textContent = (file.size / (1024 * 1024)).toFixed(2) + ' MB';
                label.textContent = 'Image selected';
                container.classList.remove('d-none');
            });

            remove.addEventListener('click', () => {
                input.value = '';

                if (previewUrl) {
                    URL.revokeObjectURL(previewUrl);
                    previewUrl = null;
                }

                preview.removeAttribute('src');
                container.classList.add('d-none');
                label.textContent = 'Click to choose an image';
            });
        })();
    </script>
}