@model Heimevernet.ViewModels.Resource.ResourceViewModel

@using System.Globalization
@using Heimevernet.Models

@{
    ViewData["Title"] = Model.Title;

    (string Css, string Label) StatusChip(ResourceStatus s) => s switch
    {
        ResourceStatus.Available => ("chip-resource-available", "Available"),
        ResourceStatus.Busy => ("chip-resource-busy", "Busy"),
        _ => ("chip-resource-busy", s.ToString())
    };

    var (statusCss, statusLabel) = StatusChip(Model.Status);
    var photos = Model.Attachments;

    // Invariant culture ensures JavaScript receives "." as the decimal separator.
    var lat = Model.Latitude.ToString(CultureInfo.InvariantCulture);
    var lng = Model.Longitude.ToString(CultureInfo.InvariantCulture);
}

@section Styles {
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="" />

    <style>
        #resourceMap {
            height: 190px;
        }

        .photo-gallery-main {
            aspect-ratio: 16 / 9;
        }
    </style>
}

<a asp-action="Index" class="back-link">
    <i class="bi bi-arrow-left"></i> Back to overview
</a>

<div class="detail-layout">

    <div class="detail-card resource-detail-card">

        <div class="resource-hero">

            <div class="resource-hero-media">
                @if (photos.Any())
                {
                    var featuredPhoto = photos.First();

                    <div class="photo-gallery-main">
                        <img src="@featuredPhoto.PublicUrl" alt="Photo of @Model.Title" />

                        @if (Model.IsOwner)
                        {
                            <div class="position-absolute bottom-0 end-0 p-2">
                                <form asp-action="DeleteAttachment" method="post"
                                      onsubmit="return confirm('Remove this photo?')">
                                    <input type="hidden" name="attachmentId" value="@featuredPhoto.Id" />
                                    <input type="hidden" name="resourceId" value="@Model.Id" />

                                    <button type="submit" class="btn btn-sm btn-danger-soft">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        }
                    </div>

                    @if (photos.Count > 1)
                    {
                        <div class="photo-gallery-thumbs">
                            @foreach (var photo in photos.Skip(1))
                            {
                                <div>
                                    <div class="photo-gallery-thumb">
                                        <img src="@photo.PublicUrl" alt="Photo of @Model.Title" />
                                    </div>

                                    @if (Model.IsOwner)
                                    {
                                        <form asp-action="DeleteAttachment" method="post" class="mt-1"
                                              onsubmit="return confirm('Remove this photo?')">
                                            <input type="hidden" name="attachmentId" value="@photo.Id" />
                                            <input type="hidden" name="resourceId" value="@Model.Id" />

                                            <button type="submit" class="btn btn-sm btn-danger-soft w-100">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="photo-gallery-empty">
                        <i class="bi bi-image fs-1"></i>
                        <p class="small mb-0">No photos available</p>
                    </div>
                }
            </div>

            <div class="resource-hero-info">
                <div class="detail-field-sub mb-1">@Model.CategoryName &middot; @Model.Region</div>
                <h1 class="detail-title">@Model.Title</h1>
                <span class="chip @statusCss"><span class="chip-dot"></span>@statusLabel</span>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="detail-desc resource-desc-compact">@Model.Description</p>
                }
            </div>

        </div>

        <hr class="detail-divider detail-divider-tight" />

        <h2 class="detail-section-title">Resource information</h2>



        <div class="detail-grid detail-grid-tight">

            <div class="detail-field">
                <i class="bi bi-geo-alt"></i>
                <div>
                    <div class="detail-field-label">Location</div>
                    <div class="detail-field-value">@Model.Region</div>
                    <div class="detail-field-sub">@Model.Latitude, @Model.Longitude</div>
                </div>
            </div>

            <div class="detail-field">
                <i class="bi bi-boxes"></i>
                <div>
                    <div class="detail-field-label">Quantity offered</div>
                    <div class="detail-field-value">@Model.QuantityOffered</div>
                </div>
            </div>

            <div class="detail-field">
                <i class="bi bi-telephone"></i>
                <div>
                    <div class="detail-field-label">Contact</div>
                    <div class="detail-field-value">@Model.ContactPoint</div>
                </div>
            </div>

            <div class="detail-field">
                <i class="bi bi-calendar-check"></i>
                <div>
                    <div class="detail-field-label">Available from</div>
                    <div class="detail-field-value">@Model.AvailableFrom.ToString("dd.MM.yyyy")</div>
                    <div class="detail-field-sub">@Model.AvailableFrom.ToString("HH:mm")</div>
                </div>
            </div>

            <div class="detail-field">
                <i class="bi bi-calendar-x"></i>
                <div>
                    <div class="detail-field-label">Available until</div>
                    @if (Model.AvailableTo.HasValue)
                    {
                        <div class="detail-field-value">@Model.AvailableTo.Value.ToString("dd.MM.yyyy")</div>
                        <div class="detail-field-sub">@Model.AvailableTo.Value.ToString("HH:mm")</div>
                    }
                    else
                    {
                        <div class="detail-field-value is-muted">No end date</div>
                    }
                </div>
            </div>

        </div>

    </div>

    <div>
        <div class="side-card">
            <h2 class="side-card-title">Location</h2>
            <div id="resourceMap" class="map-panel" data-lat="@lat" data-lng="@lng"></div>
        </div>

        @if (Model.IsOwner)
        {
            <div class="side-card">
                <h2 class="side-card-title">Manage resource</h2>
                <p class="side-card-subtitle">Manage photos and availability.</p>

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-brand w-100 mb-2">
                    Edit resource
                </a>

                <form asp-action="Delete"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="mb-3"
                      onsubmit="return confirm('Delete this resource? This cannot be undone.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger-soft w-100">
                        Delete resource
                    </button>
                </form>

                <hr class="detail-divider" />

                <form asp-action="UploadAttachment" method="post" enctype="multipart/form-data">

                    <input type="hidden" name="ResourceId" value="@Model.Id" />

                    <label for="photo" class="detail-field-label d-block mb-2">
                        Add photos
                    </label>

                    <input id="photo" type="file" name="File" required accept="image/jpeg,image/png,image/webp"
                           class="form-control mb-2" />

                    <div class="detail-field-sub mb-3">
                        JPG, PNG or WebP. Maximum 5 MB per photo.
                    </div>

                    <button type="submit" class="btn btn-brand w-100">
                        <i class="bi bi-cloud-upload me-1"></i>
                        Upload photo
                    </button>

                </form>
            </div>
        }
    </div>

</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>

    <script>
        (function () {
            const el = document.getElementById('resourceMap');
            const lat = parseFloat(el.dataset.lat);
            const lng = parseFloat(el.dataset.lng);

            const map = L.map(el, {
                scrollWheelZoom: false
            }).setView([lat, lng], 13);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            L.marker([lat, lng], {
                draggable: false
            }).addTo(map);
        })();
    </script>
}