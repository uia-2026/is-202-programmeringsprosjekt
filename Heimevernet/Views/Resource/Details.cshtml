@model Heimevernet.ViewModels.Resource.ResourceViewModel

@using System.Globalization
@using Heimevernet.Models

@{
    ViewData["Title"] = Model.Title;

    var badgeClass = Model.Status switch
    {
        ResourceStatus.Available => "bg-success",
        ResourceStatus.Busy => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    var photos = Model.Attachments;

    // Invariant culture ensures JavaScript receives "." as the decimal separator.
    var lat = Model.Latitude.ToString(CultureInfo.InvariantCulture);
    var lng = Model.Longitude.ToString(CultureInfo.InvariantCulture);
}

@section Styles {
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="" />

    <style>
        #resourceMap {
            width: 100%;
            height: 260px;
            border-radius: 8px;
        }
    </style>
}

<div class="container py-4">

    <a asp-action="Index" class="btn btn-link link-secondary text-decoration-none ps-0 mb-3">
        <i class="bi bi-arrow-left me-1"></i>
        Back to overview
    </a>

    <div class="row g-4">

        <!-- Main content -->
        <div class="col-12 col-lg-8">

            <div class="card border-0 shadow-sm overflow-hidden">

                <!-- Image gallery -->
                <div class="p-3 pb-0">

                    @if (photos.Any())
                    {
                        var featuredPhoto = photos.First();

                        <div class="ratio ratio-16x9 rounded overflow-hidden bg-light position-relative">
                            <img src="@featuredPhoto.PublicUrl" alt="Photo of @Model.Title"
                                 class="w-100 h-100 object-fit-cover" />

                            @if (Model.IsOwner)
                            {
                                <div class="position-absolute bottom-0 end-0 p-2">
                                    <form asp-action="DeleteAttachment" method="post"
                                          onsubmit="return confirm('Remove this photo?')">
                                        <input type="hidden" name="attachmentId" value="@featuredPhoto.Id" />
                                        <input type="hidden" name="resourceId" value="@Model.Id" />

                                        <button type="submit" class="btn btn-sm btn-dark bg-opacity-75">
                                            <i class="bi bi-trash me-1"></i>
                                            Remove photo
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>

                        @if (photos.Count > 1)
                        {
                            <div class="row g-2 mt-1">
                                @foreach (var photo in photos.Skip(1))
                                {
                                    <div class="col-4 col-md-3">
                                        <div class="ratio ratio-4x3 rounded overflow-hidden bg-light">
                                            <img src="@photo.PublicUrl" alt="Photo of @Model.Title"
                                                 class="w-100 h-100 object-fit-cover" />
                                        </div>

                                        @if (Model.IsOwner)
                                        {
                                            <form asp-action="DeleteAttachment" method="post" class="mt-1"
                                                  onsubmit="return confirm('Remove this photo?')">
                                                <input type="hidden" name="attachmentId" value="@photo.Id" />
                                                <input type="hidden" name="resourceId" value="@Model.Id" />

                                                <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                                    <i class="bi bi-trash"></i>
                                                    Remove
                                                </button>
                                            </form>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="ratio ratio-16x9 rounded bg-body-tertiary
                            d-flex align-items-center justify-content-center">
                            <div class="text-center text-secondary">
                                <i class="bi bi-image fs-1"></i>
                                <p class="small mb-0 mt-2">No photos available</p>
                            </div>
                        </div>
                    }

                </div>

                <!-- Resource details -->
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start
                        flex-wrap gap-2 mb-3">
                        <div>
                            <div class="text-secondary small mb-2">
                                @Model.CategoryName
                                <span class="mx-1">·</span>
                                @Model.Region
                            </div>

                            <h1 class="h3 mb-0">@Model.Title</h1>
                        </div>

                        <span class="badge @badgeClass rounded-pill px-3 py-2">
                            @Model.Status
                        </span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <hr class="my-4" />

                        <h2 class="h6 mb-2">Description</h2>
                        <p class="text-body-secondary mb-0" style="white-space: pre-line">@Model.Description</p>
                    }

                    <hr class="my-4" />

                    <h2 class="h6 mb-3">Resource information</h2>

                    <div class="row g-4">

                        <div class="col-12 col-sm-6">
                            <div class="d-flex gap-3">
                                <div class="text-secondary fs-5">
                                    <i class="bi bi-geo-alt"></i>
                                </div>
                                <div>
                                    <div class="small text-secondary">Location</div>
                                    <div class="fw-medium">@Model.Region</div>
                                    <div class="small text-secondary">
                                        @Model.Latitude, @Model.Longitude
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <div class="d-flex gap-3">
                                <div class="text-secondary fs-5">
                                    <i class="bi bi-123"></i>
                                </div>
                                <div>
                                    <div class="small text-secondary">Quantity offered</div>
                                    <div class="fw-medium">@Model.QuantityOffered</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <div class="d-flex gap-3">
                                <div class="text-secondary fs-5">
                                    <i class="bi bi-person-lines-fill"></i>
                                </div>
                                <div>
                                    <div class="small text-secondary">Contact</div>
                                    <div class="fw-medium">@Model.ContactPoint</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <div class="d-flex gap-3">
                                <div class="text-secondary fs-5">
                                    <i class="bi bi-calendar-check"></i>
                                </div>
                                <div>
                                    <div class="small text-secondary">Available from</div>
                                    <div class="fw-medium">
                                        @Model.AvailableFrom.ToString("dd.MM.yyyy")
                                    </div>
                                    <div class="small text-secondary">
                                        @Model.AvailableFrom.ToString("HH:mm")
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <div class="d-flex gap-3">
                                <div class="text-secondary fs-5">
                                    <i class="bi bi-calendar-x"></i>
                                </div>
                                <div>
                                    <div class="small text-secondary">Available until</div>

                                    @if (Model.AvailableTo.HasValue)
                                    {
                                        <div class="fw-medium">
                                            @Model.AvailableTo.Value.ToString("dd.MM.yyyy")
                                        </div>
                                        <div class="small text-secondary">
                                            @Model.AvailableTo.Value.ToString("HH:mm")
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="fw-medium">No end date</div>
                                    }
                                </div>
                            </div>
                        </div>

                    </div>

                </div>
            </div>

        </div>

        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body p-4">
                    <h2 class="h6 mb-3">Location</h2>
                    <div id="resourceMap" data-lat="@lat" data-lng="@lng"></div>
                </div>
            </div>

            @if (Model.IsOwner)
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">

                        <h2 class="h5 mb-1">Manage resource</h2>
                        <p class="text-secondary small mb-4">
                            Manage photos and availability.
                        </p>

                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-primary w-100 mb-3">
                            Edit resource
                        </a>

                        <form asp-action="Delete"
                              asp-route-id="@Model.Id"
                              method="post"
                              class="mb-3"
                              onsubmit="return confirm('Delete this resource? This cannot be undone.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger w-100">
                                Delete resource
                            </button>
                        </form>

                        <form asp-action="UploadAttachment" method="post" enctype="multipart/form-data">

                            <input type="hidden" name="ResourceId" value="@Model.Id" />

                            <label for="photo" class="form-label fw-medium">
                                Add photos
                            </label>

                            <input id="photo" type="file" name="File" required accept="image/jpeg,image/png,image/webp"
                                   class="form-control mb-2" />

                            <div class="form-text mb-3">
                                JPG, PNG or WebP. Maximum 5 MB per photo.
                            </div>

                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-cloud-upload me-1"></i>
                                Upload photo
                            </button>

                        </form>
                    </div>
                </div>
            }
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>

    <script>
        (function () {
            const el = document.getElementById('resourceMap');
            const lat = parseFloat(el.dataset.lat);
            const lng = parseFloat(el.dataset.lng);

            const map = L.map(el, {
                scrollWheelZoom: false
            }).setView([lat, lng], 13);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            L.marker([lat, lng], {
                draggable: false
            }).addTo(map);
        })();
    </script>
}
