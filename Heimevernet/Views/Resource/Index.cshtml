@model IEnumerable<Heimevernet.Models.Resource>

@{
    ViewData["Title"] = "Registered Resources";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <h1 class="h3 mb-0">Registered Resources</h1>
    <a asp-action="Create" class="btn btn-primary">Register Resource</a>
</div>

@if (Model.Any())
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
        @foreach (var resource in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-primary">Resource #@resource.Id</span>
                            <span class="badge bg-secondary">@resource.Status</span>
                        </div>
                        <h2 class="h5">@resource.Type</h2>
                        <p class="text-muted small mb-1">
                            Available @resource.AvailableFrom.ToString("dd.MM.yyyy HH:mm")
                        </p>
                        <p class="text-muted small mb-1">
                            @resource.ContactName
                        </p>
                        <p class="text-muted small mb-0">
                            @resource.ContactInfo
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="text-muted">No resources have been registered yet.</p>
}
