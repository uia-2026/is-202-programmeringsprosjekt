@model IEnumerable<Heimevernet.ViewModels.Resource.ResourceViewModel>

@{
    ViewData["Title"] = "Registered Resources";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <h1 class="h3 mb-0">Registered Resources</h1>

    <a asp-action="Create" class="btn btn-primary">
        Register Resource
    </a>
</div>

@if (ViewBag.Owners is IReadOnlyList<Heimevernet.ViewModels.Resource.ResourceOwnerOptionViewModel> owners)
{
    int? selectedOwnerId = ViewBag.SelectedOwnerId;
    int currentUserId = ViewBag.CurrentUserId;

    <form method="get" asp-action="Index" class="d-flex flex-wrap align-items-center gap-2 mb-4">
        <label for="ownerId" class="form-label mb-0 small text-muted">Owner</label>

        <select id="ownerId" name="ownerId" class="form-select form-select-sm w-auto"
                onchange="this.form.submit()">
            <option value="">All owners</option>
            @foreach (var owner in owners)
            {
                var label = owner.UserId == currentUserId ? $"{owner.Username} (you)" : owner.Username;
                <option value="@owner.UserId" selected="@(owner.UserId == selectedOwnerId)">@label</option>
            }
        </select>

        <noscript>
            <button type="submit" class="btn btn-outline-secondary btn-sm">Filter</button>
        </noscript>

        @if (selectedOwnerId.HasValue)
        {
            <a asp-action="Index" class="btn btn-link btn-sm">Clear filter</a>
        }
    </form>
}

@if (Model.Any())
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">

        @foreach (var resource in Model)
        {
            <div class="col">

                <div class="card h-100 shadow-sm">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-start mb-2">

                            <span class="badge bg-primary">
                                Resource #@resource.Id
                            </span>

                            @{
                                var badgeClass = resource.Status switch
                                {
                                    ResourceStatus.Available => "bg-success",
                                    ResourceStatus.Busy => "bg-warning text-dark",
                                    _ => "bg-secondary"
                                };
                            }

                            <span class="badge @badgeClass">
                                @resource.Status
                            </span>

                        </div>

                        <h2 class="h5">
                            @resource.Title
                        </h2>

                        <p class="text-muted small mb-1">
                            @resource.CategoryName
                        </p>

                        @if (!string.IsNullOrWhiteSpace(resource.Description))
                        {
                            <p class="small mb-2">
                                @resource.Description
                            </p>
                        }

                        <p class="text-muted small mb-1">
                            <i class="bi bi-geo-alt"></i>
                            @resource.Region
                        </p>

                        <p class="text-muted small mb-1">
                            Quantity offered: @resource.QuantityOffered
                        </p>

                        <p class="text-muted small mb-1">
                            Available
                            @resource.AvailableFrom.ToString("dd.MM.yyyy HH:mm")
                        </p>

                        @if (resource.AvailableTo.HasValue)
                        {
                            <p class="text-muted small mb-1">
                                Until
                                @resource.AvailableTo.Value.ToString("dd.MM.yyyy HH:mm")
                            </p>
                        }

                        <p class="text-muted small mb-0">
                            @resource.ContactPoint
                        </p>
                        
                        <a asp-action="Details" asp-route-id="@resource.Id" class="btn btn-outline-primary btn-sm w-100">
                            View details
                        </a>
                    </div>

                </div>

            </div>
        }

    </div>
}
else
{
    <p class="text-muted">
        @if (ViewBag.SelectedOwnerId is int)
        {
            @:No resources found for this owner.
        }
        else
        {
            @:No resources have been registered yet.
        }
    </p>
}